--- !yfi/header
version: 1
namespace: shadow::app
---
# `child`'s `extends: Widget` was written against this file's own `&Widget`.
# Adding the binding below outranks it, so one unmodified line silently starts
# naming another directory's node -- and with matching keys there is no signal
# at all. The binding is diagnosed rather than allowed to retarget it.
Widget: !type &Widget
  near: !!int 1
Use: !node &Use
  Widget: !ref ../other/Widget
  child: !node
    extends: Widget
