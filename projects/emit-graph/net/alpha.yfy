--- !yfi/header
version: 1
namespace: emit::net
visibility: public
---
// A legal data cycle: only inheritance may not close one. `./Beta` is anchored
// and is a reach; `alpha` is not anchored and stays a string.
Alpha: !node &Alpha
  peer: ./Beta
  label: alpha

// An alias is a data edge too. Its scope is the document (D2.6), where a path's
// is the project — same edge, two reaches.
Gamma: !node &Gamma
  mate: *Alpha
