--- !yfi/header
version: 1
namespace: ovr::patch
visibility: public
---
# `override` inverts D4.5's additivity for this contribution alone: `vessel`
# outranks the base's own key rather than ranking below it, so no W0303.
Amend: !node &Amend
  extends: !ref override ../base/Potion
  pub vessel: flask
