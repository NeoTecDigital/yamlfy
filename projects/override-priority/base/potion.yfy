--- !yfi/header
version: 1
namespace: ovp::base
visibility: public
---
# This scope says nothing about mutability, so it is immutable (D6.4). Every
# `!ref` into it from outside is refused; every `override` into it is not,
# because a priority claim is not a mutation.
Potion: !type &Potion
  pub vessel: vial
