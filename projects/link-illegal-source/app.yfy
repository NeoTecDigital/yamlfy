--- !yfi/header
version: 1
namespace: bad
---
Base: !type &Base
  port: !!int
Items: !type &Items
  - one
  - two
plain: &plain just-a-string
legal: !node
  <<: [*Base, {inline: 1}]
  extends: *Base
scalar-source: !node
  <<: *plain
nested-source: !node
  <<: [[*Base]]
sequence-ref: !node
  <<: Items
bad-extends: !node
  extends: 7
