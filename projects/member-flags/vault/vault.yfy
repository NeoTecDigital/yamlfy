--- !yamlfy/header
version: 1
namespace: mf::vault
visibility: private
mutability: mutable
---
// A `pub mut` member of a `private immutable` scope is public and mutable
// *within* that scope. The scope path still gates reach from outside, which is
// D6.5's composition one level down rather than a second rule.
Ledger: !node &Ledger
  pub mut entries: !!int 0
